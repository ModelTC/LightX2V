{
  "infer_steps": 30,
  "target_video_length": 124,
  "target_height": 544,
  "target_width": 960,
  "fps": 24,
  "target_fps": 24,
  "enable_cfg": false,
  "cpu_offload": true,
  "offload_granularity": "model",
  "text_encoder_cpu_offload": true,
  "text_encoder_tensor_parallel": true,
  "text_encoder_host_pinned": false,
  "vae_cpu_offload": true,
  "lazy_load": false,
  "unload_modules": false,
  "attn_type": "intel_xpu_cute_attn",
  "rms_type": "intel_xpu",
  "tp_mm_type": "IntelTensorParallel",
  "rope_type": "minimax_h3_xpu_rope",
  "feature_caching": "NoCaching",
  "use_compile": true,
  "video_flow_shift": 12.0,
  "audio_flow_shift": 3.0,
  "vae_spatial_scale_factor": 16,
  "audio_sampling_rate": 32000,
  "audio_latents_per_second": 40,
  "audio_channels": 2,
  "keep_latents_dtype_in_scheduler": true,
  "dit_quantized": true,
  "dit_quant_scheme": "int8-intel-xpu",
  "dit_quantized_ckpt": "/path/to/minimax_h3_int8.safetensors",
  "parallel": {
    "seq_p_size": 2,
    "seq_p_attn_type": "ulysses",
    "seq_p_a2a_backend": "torch",
