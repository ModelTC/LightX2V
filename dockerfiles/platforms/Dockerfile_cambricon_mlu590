FROM cambricon-base/pytorch:v25.10.0-torch2.8.0-torchmlu1.29.1-ubuntu22.04-py310 AS base

WORKDIR /workspace/LightX2V

# Set envs
ENV PYTHONPATH=/workspace/LightX2V
ENV LD_LIBRARY_PATH=/usr/local/neuware/lib64:${LD_LIBRARY_PATH}

# Install deps without replacing the vendor Torch / torch_mlu stack.
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && \
    python -c "import importlib.metadata as m; from pathlib import Path; names = {'torch', 'torchvision', 'torchaudio', 'torch-mlu'}; Path('/tmp/vendor-torch-constraints.txt').write_text(''.join(d.metadata['Name'] + '==' + d.version + '\n' for d in m.distributions() if d.metadata['Name'].lower().replace('_', '-') in names))" && \
    python -m pip install --no-cache-dir --constraint /tmp/vendor-torch-constraints.txt \
    ftfy \
    imageio \
    imageio-ffmpeg \
    loguru \
    aiohttp \
    gguf \
    diffusers \
    peft==0.17.0 \
    transformers==4.57.1 \
    Pillow && \
    rm /tmp/vendor-torch-constraints.txt

# Copy files
COPY app app
COPY assets assets
COPY configs configs
COPY lightx2v lightx2v
COPY lightx2v_kernel lightx2v_kernel
COPY lightx2v_platform lightx2v_platform
COPY scripts scripts
COPY test_cases test_cases
COPY tools tools
