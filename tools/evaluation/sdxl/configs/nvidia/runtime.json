  "p95_latency_ratio_max": 1.5,
  "generation_environment": {
    "PLATFORM": "cuda",
    "DTYPE": "BF16",
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "CUBLAS_WORKSPACE_CONFIG": null,
    "OMP_NUM_THREADS": "8",
    "MKL_NUM_THREADS": "8",
    "OPENBLAS_NUM_THREADS": "1",
    "PROFILING_DEBUG_LEVEL": "0",
    "PYTHONUNBUFFERED": "1",
    "PYTHONDONTWRITEBYTECODE": "1",
    "TOKENIZERS_PARALLELISM": "false"
  }
}
