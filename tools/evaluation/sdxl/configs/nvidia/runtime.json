{
  "status": "implemented",
  "device_api": "torch.cuda",
  "single_gpu": true,
  "batch_size": 1,
  "seed": 42,
  "chunk_size_max": 256,
  "execution_timeout_seconds": 3300,
  "resource_monitor": "pinned LightX2V tools/runtime/gpu_watch.py",
  "native_and_lightx2v": "serial on the same physical GPU",
