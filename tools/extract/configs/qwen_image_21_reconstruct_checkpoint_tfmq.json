{
  "source_model": "lightx2v_train/models/Qwen-Image-2.1",
  "target_model": "lightx2v_train/models/Qwen-Image-2.1-Lightning-v2-RL/diffusion_pytorch_model.safetensors",
  "output": "outputs/qwen_image_21_rl_tfmq_r64_a8.safetensors",
  "rank": 64,
  "alpha": 8,
  "dtype": "fp32",
  "device": "auto",
  "key_prefix": "transformer",
  "layers": [
    "transformer_blocks.*.attn.to_q",
    "transformer_blocks.*.attn.to_k",
    "transformer_blocks.*.attn.to_v",
    "transformer_blocks.*.attn.to_out.0",
    "transformer_blocks.*.img_mlp.gate_layer",
    "transformer_blocks.*.img_mlp.proj",
    "transformer_blocks.*.img_mlp.out",
    "time_text_embed.timestep_embedder.linear_1",
    "time_text_embed.timestep_embedder.linear_2",
    "modulation.1",
    "norm_out.linear",
    "img_in",
    "txt_in.in_layer",
    "txt_in.out_layer",
    "proj_out"
  ],
  "algorithm": "tfmq",
  "calibration": "outputs/qwen_image_21_rl_calibration",
  "work_dir": "outputs/reconstruction_rl_tfmq",
  "initialization": "svd",
  "compute_dtype": "bf16",
  "iterations": 500,
  "temporal_iterations": 1000,
  "learning_rate": 5e-05,
  "gradient_clip": 1.0,
  "checkpointing": true,
  "seed": 42,
  "log_every": 25,
  "calibration_manifest": "lightx2v_train/data/opengpt4o_qwen_image21/train.jsonl",
  "calibration_counts": {
    "t2i": 256,
    "i2i_single": 128,
    "i2i_multi": 128
  },
  "calibration_inference_config": "tools/extract/configs/qwen_image_21_calibration.json",
  "batch_size": 8,
  "save_iteration_losses": true
}
